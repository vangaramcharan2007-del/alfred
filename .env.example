# Jarvis X / Alfred Environment Configuration
#
# Copy this file to `.env` in the repo root and fill in what you use.
# `jarvisx.agentic` loads `.env` automatically — no export needed, no
# python-dotenv dependency. Check your setup with:
#
#     python -m jarvisx.agentic doctor
#
# Never commit `.env`. It is gitignored.

# ---------------------------------------------------------------------------
# Model provider — pick ONE. This is what makes the agents actually think.
# Without one of these, agents run in offline "heuristic" mode, which writes
# a placeholder file instead of real code.
# ---------------------------------------------------------------------------

# Groq (fast, recommended) — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# Must be a model that supports tool calling, or the agent cannot use tools.
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT=60

# OpenRouter (many models through one key) — https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI
# OPENAI_API_KEY=sk-your_key_here

# Local Ollama (fully offline, no key needed) — https://ollama.com
# The agentic layer needs the OpenAI-compatible endpoint, so use /v1.
# A trailing /api is normalised automatically.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=ollama

# ---------------------------------------------------------------------------
# Agentic harness overrides (all optional)
# ---------------------------------------------------------------------------

# Force a backend: auto | groq | offline
# ALFRED_AGENT_BACKEND=auto
# Overrides the provider's model choice for the agent loop.
# ALFRED_AGENT_MODEL=

# ---------------------------------------------------------------------------
# OmniRoute Gateway
# ---------------------------------------------------------------------------
OMNIROUTE_PATH=modules/OmniRoute
OMNIROUTE_HOST=127.0.0.1
OMNIROUTE_PORT=20128
OMNIROUTE_API_KEY=sk-omniroute
DEFAULT_MODEL=llama3
FALLBACK_MODEL=llama3

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------
MEMORY_DB_PATH=var/jarvis.db
